---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHOR_NAME } from '../../consts';
import { t, type Locale } from '../../i18n/strings';
import { LOCALES } from '../../utils/i18n';
import AboutEn from './_about-en.astro';
import AboutJa from './_about-ja.astro';

export const getStaticPaths = (() =>
  LOCALES.map(lang => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;

const description =
  lang === 'ja'
    ? t('authorBio', lang)
    : `Software engineer in Japan building open-source tools. About ${AUTHOR_NAME}.`;
---

<BaseLayout title="About" description={description}>
  {lang === 'en' ? <AboutEn /> : <AboutJa />}
</BaseLayout>
