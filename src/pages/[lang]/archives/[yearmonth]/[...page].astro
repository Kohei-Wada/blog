---
import type { GetStaticPaths } from 'astro';
import BlogListLayout from '../../../../layouts/BlogListLayout.astro';
import { SITE_TITLE, POSTS_PER_PAGE } from '../../../../consts';
import { getCollection } from 'astro:content';
import {
  groupPostsByMonth,
  parseArchiveSlug,
  formatArchiveLabel,
} from '../../../../utils/archive-utils';
import { getPostLang, LOCALES, otherLocale, type Locale } from '../../../../i18n/locale';
import { isPublished } from '../../../../utils/content-aggregation';

export const getStaticPaths = (async ({ paginate }) => {
  const all = await getCollection('blog', isPublished);
  return LOCALES.flatMap(lang => {
    const posts = all.filter(p => getPostLang(p.id) === lang);
    return groupPostsByMonth(posts).flatMap(archive =>
      paginate(archive.posts, {
        params: { lang, yearmonth: archive.slug },
        pageSize: POSTS_PER_PAGE,
      })
    );
  });
}) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const { yearmonth: yearMonthParam } = Astro.params;
if (!yearMonthParam) {
  throw new Error('Year-month parameter is required');
}

const parsed = parseArchiveSlug(yearMonthParam);
if (!parsed) {
  throw new Error(`Invalid year-month format: ${yearMonthParam}`);
}

const { page } = Astro.props;
const { year, month } = parsed;
const jaLabel = formatArchiveLabel(year, month);

const copy = {
  en: {
    base: `Posts from ${yearMonthParam}`,
    pageSuffix: (n: number) => ` - Page ${n}`,
    description: `Blog posts published in ${yearMonthParam}.`,
  },
  ja: {
    base: `${jaLabel}の記事`,
    pageSuffix: (n: number) => ` - ${n}ページ目`,
    description: `${jaLabel}に投稿された記事一覧です。`,
  },
}[lang];

const title = `${copy.base}${
  page.currentPage > 1 ? copy.pageSuffix(page.currentPage) : ''
} - ${SITE_TITLE}`;
const description = copy.description;
---

<BlogListLayout
  title={title}
  description={description}
  posts={page.data}
  sectionLabel="LISTING"
  command={`ls -l archives/${yearMonthParam}/`}
  siblingHref={`/${otherLocale(lang)}/`}
  page={page}
  baseUrl={`/${lang}/archives/${yearMonthParam}/`}
/>
