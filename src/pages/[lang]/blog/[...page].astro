---
import type { GetStaticPaths } from 'astro';
import BlogListLayout from '../../../layouts/BlogListLayout.astro';
import { SITE_TITLE, POSTS_PER_PAGE } from '../../../consts';
import { getCollection } from 'astro:content';
import { sortPostsByDate } from '../../../utils/content-aggregation';
import { getPostLang, LOCALES, type Locale } from '../../../i18n/locale';

export const getStaticPaths = (async ({ paginate }) => {
  const all = await getCollection('blog');
  return LOCALES.flatMap(lang => {
    const posts = sortPostsByDate(all.filter(p => getPostLang(p.id) === lang));
    return paginate(posts, { params: { lang }, pageSize: POSTS_PER_PAGE });
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const lang = Astro.params.lang as Locale;

const copy = {
  en: {
    base: 'Blog',
    pageN: (n: number) => `Blog - Page ${n}`,
    description: `All blog posts on ${SITE_TITLE} — technical notes on software, tools, and infrastructure.`,
  },
  ja: {
    base: 'ブログ',
    pageN: (n: number) => `ブログ - ${n}ページ目`,
    description: `${SITE_TITLE} の全ブログ記事一覧。ソフトウェアやツール、インフラに関する技術メモ。`,
  },
}[lang];

const title = `${page.currentPage > 1 ? copy.pageN(page.currentPage) : copy.base} - ${SITE_TITLE}`;
---

<BlogListLayout
  title={title}
  description={copy.description}
  posts={page.data}
  command="ls -l blog/"
  page={page}
  baseUrl={`/${lang}/blog/`}
/>
