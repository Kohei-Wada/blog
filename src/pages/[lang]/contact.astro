---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/strings';
import { LOCALES } from '../../utils/i18n';

export const getStaticPaths = (() =>
  LOCALES.map(lang => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;

const copy = {
  en: {
    description: 'Contact form — questions, feedback, and work inquiries welcome.',
    name: 'contact — get in touch',
    body: 'Questions, feedback, work inquiries — feel free to reach out.',
    formName: 'contact',
    nameLabel: 'Name',
    namePlaceholder: 'Jane Doe',
    emailLabel: 'Email',
    subjectLabel: 'Subject',
    subjectPlaceholder: "What's this about?",
    messageLabel: 'Message',
    messagePlaceholder: 'Write your message here',
    submit: 'Send',
  },
  ja: {
    description: 'お問い合わせフォーム。ご質問やご連絡はこちらからどうぞ。',
    name: 'contact — お問い合わせ',
    body: 'ご質問、フィードバック、お仕事のご依頼など、お気軽にお声をおかけください。',
    formName: 'contact-ja',
    nameLabel: 'お名前',
    namePlaceholder: '山田 太郎',
    emailLabel: 'メールアドレス',
    subjectLabel: '件名',
    subjectPlaceholder: 'お問い合わせの件名',
    messageLabel: 'メッセージ',
    messagePlaceholder: 'お問い合わせ内容をご記入ください',
    submit: '送信する',
  },
}[lang];
---

<BaseLayout title="Contact - Kohei Wada" description={copy.description}>
  <section class="man-section">
    <h2>NAME</h2>
    <p>{copy.name}</p>
  </section>

  <section class="man-section">
    <h2>DESCRIPTION</h2>
    <p>{copy.body}</p>
  </section>

  <section class="man-section">
    <h2>CHANNELS</h2>
    <form
      name={copy.formName}
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="contact-form"
    >
      <input type="hidden" name="form-name" value={copy.formName} />
      <p hidden>
        <label>
          Don't fill this out: <input name="bot-field" />
        </label>
      </p>

      <div class="form-group">
        <label for="name" class="form-label">{copy.nameLabel}</label>
        <input
          type="text"
          id="name"
          name="name"
          class="form-input"
          placeholder={copy.namePlaceholder}
        />
      </div>

      <div class="form-group">
        <label for="email" class="form-label">
          {copy.emailLabel}<span class="required">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          class="form-input"
          placeholder="example@email.com"
          required
        />
      </div>

      <div class="form-group">
        <label for="subject" class="form-label">{copy.subjectLabel}</label>
        <input
          type="text"
          id="subject"
          name="subject"
          class="form-input"
          placeholder={copy.subjectPlaceholder}
        />
      </div>

      <div class="form-group">
        <label for="message" class="form-label">
          {copy.messageLabel}<span class="required">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          class="form-textarea"
          placeholder={copy.messagePlaceholder}
          required></textarea>
      </div>

      <button type="submit" class="submit-button">{copy.submit}</button>
    </form>
  </section>

  <section class="man-section">
    <h2>SEE ALSO</h2>
    <p>
      <a href={`/${lang}/about`}>about(1)</a>,
      <a href={`/${lang}/privacy`}>privacy(1)</a>
    </p>
  </section>

  <style>
    .contact-form {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-md);
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
    }

    .form-label {
      font-weight: 600;
      color: var(--color-text);
      font-size: var(--font-size-sm);
    }

    .form-label .required {
      color: #e53e3e;
      margin-left: 0.25rem;
    }

    .form-input,
    .form-textarea {
      padding: 0.75rem 1rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background: var(--color-bg);
      color: var(--color-text);
      font-size: var(--font-size-base);
      font-family: inherit;
      transition:
        border-color var(--transition-fast),
        box-shadow var(--transition-fast);
    }

    .form-input:focus,
    .form-textarea:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(35, 55, 255, 0.1);
    }

    .form-input::placeholder,
    .form-textarea::placeholder {
      color: var(--color-text-secondary);
      opacity: 0.6;
    }

    .form-textarea {
      min-height: 180px;
      resize: vertical;
    }

    .submit-button {
      align-self: flex-start;
      padding: 0.75rem 2rem;
      background: var(--accent);
      color: white;
      border: none;
      border-radius: var(--radius-md);
      font-size: var(--font-size-base);
      font-weight: 600;
      cursor: pointer;
      transition:
        background var(--transition-fast),
        transform var(--transition-fast);
    }

    .submit-button:hover {
      background: var(--accent-dark);
    }

    .submit-button:active {
      transform: scale(0.98);
    }

    @media (max-width: 720px) {
      .submit-button {
        width: 100%;
      }
    }
  </style>
</BaseLayout>
