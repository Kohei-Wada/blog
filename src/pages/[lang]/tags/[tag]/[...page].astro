---
import type { GetStaticPaths } from 'astro';
import BlogListLayout from '../../../../layouts/BlogListLayout.astro';
import { SITE_TITLE, POSTS_PER_PAGE } from '../../../../consts';
import { getCollection } from 'astro:content';
import { getAllTags, getPostsByTag, sortPostsByDate } from '../../../../utils/content-aggregation';
import { getPostLang, LOCALES, otherLocale, type Locale } from '../../../../i18n/locale';

export const getStaticPaths = (async ({ paginate }) => {
  const all = await getCollection('blog');
  return LOCALES.flatMap(lang => {
    const posts = all.filter(p => getPostLang(p.id) === lang);
    return getAllTags(posts).flatMap(tag => {
      const tagPosts = sortPostsByDate(getPostsByTag(posts, tag));
      return paginate(tagPosts, { params: { lang, tag }, pageSize: POSTS_PER_PAGE });
    });
  });
}) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const { tag } = Astro.params;
if (!tag) {
  throw new Error('Tag parameter is required');
}

const { page } = Astro.props;

const copy = {
  en: {
    base: `Posts tagged "${tag}"`,
    pageSuffix: (n: number) => ` - Page ${n}`,
    description: `Blog posts tagged "${tag}" on ${SITE_TITLE}.`,
  },
  ja: {
    base: `タグ「${tag}」の記事`,
    pageSuffix: (n: number) => ` - ${n}ページ目`,
    description: `${SITE_TITLE} のタグ「${tag}」が付いた記事一覧。`,
  },
}[lang];

const title = `${copy.base}${
  page.currentPage > 1 ? copy.pageSuffix(page.currentPage) : ''
} - ${SITE_TITLE}`;
---

<BlogListLayout
  title={title}
  description={copy.description}
  posts={page.data}
  sectionLabel="APROPOS"
  command={`ls -l tags/${tag}/`}
  siblingHref={`/${otherLocale(lang)}/`}
  page={page}
  baseUrl={`/${lang}/tags/${tag}/`}
/>
