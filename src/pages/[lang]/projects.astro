---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ManCommand from '../../components/shared/ui/ManCommand.astro';
import { getCollection, getEntry } from 'astro:content';
import { localeStaticPaths, type Locale } from '../../i18n/locale';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;

const copy = {
  en: {
    title: 'Projects — wada-dev',
    description:
      'A showcase of my OSS work. Each project lists what it is, its stack, repo link, and related posts.',
    name: 'projects — OSS showcase',
    body: 'A list of my open-source projects. Each entry includes the description, stack, repository link, and related write-ups.',
  },
  ja: {
    title: 'プロジェクト — wada-dev',
    description:
      'OSS 作品のショーケース。各プロジェクトの概要、技術スタック、リポジトリ、関連記事を一覧。',
    name: 'projects — OSS 作品ショーケース',
    body: '自作の OSS 作品を一覧します。各プロジェクトの概要、使用技術、リポジトリへのリンク、関連する制作過程記事をまとめています。',
  },
}[lang];

const STATUS_ORDER = ['active', 'maintenance', 'archived'] as const;

const all = await getCollection('projects');
const sorted = all.sort((a, b) => {
  const status = STATUS_ORDER.indexOf(a.data.status) - STATUS_ORDER.indexOf(b.data.status);
  if (status !== 0) return status;
  if (b.data.order !== a.data.order) return b.data.order - a.data.order;
  return a.data.name.localeCompare(b.data.name);
});

// Resolve related-post slugs to title/href so missing slugs fail loudly at build.
async function resolveRelated(slugs: string[]): Promise<Array<{ title: string; href: string }>> {
  const resolved = await Promise.all(
    slugs.map(async slug => {
      const post = await getEntry('blog', `${lang}/${slug}`);
      if (!post) {
        throw new Error(
          `project relatedPosts entry "${slug}" did not resolve under blog/${lang}/. ` +
            `Either add the post or remove the slug.`
        );
      }
      return { title: post.data.title, href: `/${lang}/blog/${slug}` };
    })
  );
  return resolved;
}

const projects = await Promise.all(
  sorted.map(async item => ({
    ...item,
    related: await resolveRelated(item.data.relatedPosts),
  }))
);
---

<BaseLayout title={copy.title} description={copy.description}>
  <section class="man-section">
    <h1>NAME</h1>
    <p>{copy.name}</p>
  </section>

  <section class="man-section">
    <h2>DESCRIPTION</h2>
    <ManCommand cmd="cat projects/*.md" />
    <p>{copy.body}</p>

    {
      projects.map(item => (
        <div class="project">
          <h3>{item.data.name}</h3>
          <p class="project-desc">
            {lang === 'ja' ? item.data.description : item.data.description_en}
          </p>
          <dl class="project-fields">
            {/* active is the default; man pages only note the deviations. */}
            {item.data.status !== 'active' && (
              <>
                <dt>status:</dt>
                <dd>{item.data.status}</dd>
              </>
            )}

            {item.data.stack.length > 0 && (
              <>
                <dt>stack:</dt>
                <dd>
                  {item.data.stack.map((s, i) => (
                    <>
                      {s}
                      {i < item.data.stack.length - 1 && <span class="sep"> · </span>}
                    </>
                  ))}
                </dd>
              </>
            )}

            <dt>repo:</dt>
            <dd>
              <a href={item.data.repo}>{item.data.repo.replace(/^https?:\/\//, '')}</a>
            </dd>

            {item.related.length > 0 && (
              <>
                <dt>related:</dt>
                <dd>
                  {item.related.map((r, i) => (
                    <>
                      <a href={r.href}>{r.title}</a>
                      {i < item.related.length - 1 && <span class="sep"> · </span>}
                    </>
                  ))}
                </dd>
              </>
            )}
          </dl>
        </div>
      ))
    }
  </section>

  <section class="man-section">
    <h2>SEE ALSO</h2>
    <p>
      <a href="https://github.com/Kohei-Wada">github(1)</a>, <a href={`/${lang}/blog`}>blog(7)</a>
    </p>
  </section>

  <style>
    .project {
      margin: 1.25em 0 0;
    }
    .project h3 {
      margin: 0 0 0.25em;
    }
    .project-desc {
      margin: 0 0 0.25em;
    }
    /* man(7) indents field bodies to a fixed column, like a .TP list. Type
       stays at body size — a man page has one font; structure is columns. */
    .project-fields {
      display: grid;
      grid-template-columns: 9ch minmax(0, 1fr);
      gap: 0 1ch;
      margin: 0.25em 0 0;
    }
    .project-fields dt {
      color: var(--text-dim);
    }
    .project-fields dd {
      margin: 0;
    }
    .sep {
      color: var(--text-dim);
    }

    @media (max-width: 480px) {
      .project-fields {
        grid-template-columns: minmax(0, 1fr);
      }
      .project-fields dd {
        padding-left: var(--indent-section);
      }
    }
  </style>
</BaseLayout>
