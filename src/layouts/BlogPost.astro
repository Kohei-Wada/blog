---
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/blog/Comments.astro';
import { getCollection } from 'astro:content';
import { resolveSeeAlso } from '../utils/see-also';
import { getPostLang, getPostSlug } from '../i18n/locale';
import { isPublished, sortPostsByDate } from '../utils/content-aggregation';
import { t } from '../i18n/strings';

interface Props {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  seeAlso?: string[];
}

const { id, title, description, pubDate, tags, seeAlso = [] } = Astro.props;

const lang = getPostLang(id);
const slug = getPostSlug(id);
const manTitle = slug.toUpperCase().replace(/-/g, '_');
const pubIso = pubDate.toISOString().slice(0, 10);

const all = await getCollection('blog', isPublished);
const seeAlsoEntries = resolveSeeAlso(seeAlso, id, all);

const otherLang = lang === 'ja' ? 'en' : 'ja';
const hasTranslation = all.some(p => getPostLang(p.id) === otherLang && getPostSlug(p.id) === slug);
const siblingHref = hasTranslation ? `/${otherLang}/blog/${slug}` : `/${otherLang}/`;

const localePosts = sortPostsByDate(all.filter(p => getPostLang(p.id) === lang));
const postIndex = localePosts.findIndex(p => p.id === id);
const newerPost = postIndex > 0 ? localePosts[postIndex - 1] : null;
const olderPost =
  postIndex >= 0 && postIndex < localePosts.length - 1 ? localePosts[postIndex + 1] : null;
const postHref = (p: (typeof localePosts)[number]) => `/${lang}/blog/${getPostSlug(p.id)}`;
---

<BaseLayout
  title={title}
  description={description}
  siblingHref={siblingHref}
  isArticle={true}
  publishedTime={pubDate}
  alternateHref={hasTranslation ? `${siblingHref}/` : undefined}
>
  <article>
    <section class="man-section">
      <h1>NAME</h1>
      <p>{slug} — {title}</p>
    </section>

    <section class="man-section">
      <h2>SYNOPSIS</h2>
      <p>{description}</p>
    </section>

    <section class="man-section man-description">
      <h2>DESCRIPTION</h2>
      <div class="post-body">
        <slot />
      </div>
    </section>

    {
      seeAlsoEntries.length > 0 && (
        <section class="man-section">
          <h2>SEE ALSO</h2>
          <ul class="see-also">
            {seeAlsoEntries.map(e => (
              <li>
                <a href={e.href}>{e.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      tags.length > 0 && (
        <p class="post-tags">
          <span class="label">tags: </span>
          {tags.map((tag, i) => (
            <span>
              <a href={`/${lang}/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
              {i < tags.length - 1 && <span class="tag-sep"> · </span>}
            </span>
          ))}
        </p>
      )
    }

    <Comments slug={slug} lang={lang} />

    <footer class="post-bottom-rule">
      <hr class="man-rule" />
      {
        (olderPost || newerPost) && (
          <nav class="post-nav" aria-label={t('navigation', lang)}>
            <ul>
              {newerPost && (
                <li>
                  <span class="label">{t('nextPost', lang)}: </span>
                  <a href={postHref(newerPost)}>{newerPost.data.title}</a>
                </li>
              )}
              {olderPost && (
                <li>
                  <span class="label">{t('prevPost', lang)}: </span>
                  <a href={postHref(olderPost)}>{olderPost.data.title}</a>
                </li>
              )}
            </ul>
          </nav>
        )
      }
      <div class="man-footer">
        <span>{manTitle}(7)</span>
        <span>{pubIso}</span>
      </div>
    </footer>
  </article>

  <style>
    /* man(7) subsections don't scale type: SH/SS are body-sized bold. Keep
       markdown headings at body size so they never outweigh the section
       headers (NAME, DESCRIPTION, ...) they sit under. :global() because the
       slotted markdown carries no astro scope attribute. */
    .post-body :global(:where(h2, h3, h4)) {
      text-transform: none;
      letter-spacing: 0;
      font-size: var(--font-size-base);
      font-weight: bold;
    }
    /* man(7) puts SS headers between the section header (col 0) and the
       body (col 7); half the indent keeps that on any --indent-section. */
    .post-body :global(h2) {
      margin-left: calc(var(--indent-section) / -2);
    }
    .see-also {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .see-also li {
      padding: 0.15em 0;
    }
    .tag-sep {
      color: var(--text-dim);
    }
    .post-tags {
      margin: 1.5em 0 0;
    }
    .post-tags .label {
      color: var(--text-dim);
    }
    .post-nav {
      margin: 0.5em 0;
    }
    .post-nav ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .post-nav li {
      padding: 0.15em 0;
    }
    .post-nav .label {
      color: var(--text-dim);
    }
  </style>
</BaseLayout>
