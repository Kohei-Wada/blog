---
// Import CSS files directly here so that Vite can optimize them.
// This prevents FOUC (Flash of Unstyled Content) in Firefox
// by avoiding CSS @import which Firefox parses sequentially.
import '../../../styles/base/variables.css';
import '../../../styles/base/reset.css';
import '../../../styles/base/typography.css';
import '../../../styles/base/responsive.css';
import '../../../styles/components/man-page.css';
import '../../../styles/components/tables.css';
import {
  SITE_TITLE,
  SOCIAL_LINKS,
  X_HANDLE,
  AUTHOR_NAME,
  AUTHOR_IMAGE_URL,
  AUTHOR_JOB_TITLE,
} from '../../../consts';
import { t } from '../../../i18n/strings';
import { localeFromUrl, otherLocale } from '../../../i18n/locale';
import { FEED_PATHS } from '../../../utils/rss';
import FallbackImage from '../../../assets/avatar.png';
import type { ImageMetadata } from 'astro';
import Analytics from '../ui/Analytics.astro';
import {
  generateBlogPostingSchema,
  generateWebSiteSchema,
  generateOrganizationSchema,
  generatePersonSchema,
  combineSchemas,
} from '../../../utils/jsonld';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  isArticle?: boolean;
  publishedTime?: Date;
  /** Path of this page in the other locale — only when that page exists. */
  alternateHref?: string;
  /** Emit robots noindex and no canonical/hreflang (error pages). */
  noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const locale = localeFromUrl(Astro.url);

const {
  title,
  description,
  image = FallbackImage,
  isArticle = false,
  publishedTime,
  alternateHref,
  noindex = false,
} = Astro.props;

const alternateURL = alternateHref ? new URL(alternateHref, Astro.site) : null;

// Generate JSON-LD structured data
const siteUrl = Astro.site?.toString() || 'https://wada-dev.com';
const pageUrl = canonicalURL.toString();

let jsonLdData: object;

if (isArticle && publishedTime) {
  // Blog post page - use BlogPosting schema
  jsonLdData = generateBlogPostingSchema({
    title,
    description,
    url: pageUrl,
    inLanguage: locale,
    datePublished: publishedTime,
    dateModified: publishedTime, // Can be updated if we track modification dates
    image,
    authorName: AUTHOR_NAME,
    authorUrl: siteUrl,
    authorImage: AUTHOR_IMAGE_URL,
  });
} else {
  // Other pages - use WebSite + Organization + Person schemas
  const websiteSchema = generateWebSiteSchema({
    name: SITE_TITLE,
    description: t('siteDescription', locale),
    url: siteUrl,
    inLanguage: locale,
  });

  const organizationSchema = generateOrganizationSchema({
    name: SITE_TITLE,
    url: siteUrl,
    sameAs: SOCIAL_LINKS,
  });

  const personSchema = generatePersonSchema({
    name: AUTHOR_NAME,
    url: siteUrl,
    image: AUTHOR_IMAGE_URL,
    sameAs: SOCIAL_LINKS,
    jobTitle: AUTHOR_JOB_TITLE,
    description: t('authorBio', locale),
  });

  jsonLdData = combineSchemas([websiteSchema, organizationSchema, personSchema]);
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_TITLE} (${locale === 'ja' ? '日本語' : 'English'})`}
  href={new URL(FEED_PATHS[locale], Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}

{
  alternateURL && (
    <>
      <link rel="alternate" hreflang={locale} href={canonicalURL} />
      <link rel="alternate" hreflang={otherLocale(locale)} href={alternateURL} />
      <link
        rel="alternate"
        hreflang="x-default"
        href={locale === 'en' ? canonicalURL : alternateURL}
      />
    </>
  )
}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={isArticle ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />
<meta property="og:image:alt" content={`${title} - ${SITE_TITLE}`} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : 'en_US'} />
{
  isArticle && publishedTime && (
    <meta property="article:published_time" content={publishedTime.toISOString()} />
  )
}
{isArticle && <meta property="article:author" content={AUTHOR_NAME} />}
{isArticle && <meta property="article:section" content="Technology" />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image.src, Astro.url)} />
<meta name="twitter:image:alt" content={`${title} - ${SITE_TITLE}`} />
<meta name="twitter:creator" content={X_HANDLE} />
<meta name="twitter:site" content={X_HANDLE} />

<Analytics />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdData)} />
