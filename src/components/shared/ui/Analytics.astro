---
import { ANALYTICS } from '../../../constants/api';

const isProduction: boolean = import.meta.env.PROD;
const measurementId = ANALYTICS.GA_MEASUREMENT_ID;
const gaInit = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${measurementId}');`;
---

{
  isProduction && (
    <>
      <script async src={`${ANALYTICS.GOOGLE_TAG_MANAGER}?id=${measurementId}`} />
      <script is:inline set:html={gaInit} />
    </>
  )
}
